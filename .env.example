# Copier en .env et remplir. Le .env n est jamais commite.
#
# Un seul fichier d environnement pour tout le depot. Il est lu par :
#   - docker compose, pour les ${...} du docker-compose.yml
#   - le backend lance hors docker (services/backend/app/config.py)
#   - Vite, pour les variables prefixees VITE_ (services/web/vite.config.ts)

# Base de donnees
POSTGRES_USER=seo
POSTGRES_PASSWORD=change_moi
POSTGRES_DB=seo
DB_HOST_PORT=5432

# Utilise uniquement quand le backend tourne hors docker (alembic, pytest).
# Sous docker compose, DATABASE_URL est fabriquee par le compose et pointe
# vers l hote "db".
DATABASE_URL=postgresql+psycopg://seo:change_moi@127.0.0.1:5432/seo

# Source de donnees (adresse donnee par le formateur, jamais en dur dans le code)
SOURCE_API_BASE_URL=http://127.0.0.1:8000

# API
API_PORT=8080
WEB_PORT=80
JWT_SECRET_KEY=replace-with-a-random-32-character-minimum-secret
SEED_USER_PASSWORD=EnerVisionDemo2026!
DATABASE_WAIT_SECONDS=30
PREDICTION_REFRESH_INTERVAL_SECONDS=60

# Front
# Laisser vide tant que le front passe par le proxy Vite ou Nginx.
VITE_BACK_API_URL=

# Donnees de demonstration
# Inserees par le conteneur migrate au demarrage. Mettre 0 pour une base vide.
SEED_DEMO_DATA=1
