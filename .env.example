# Copier en .env et remplir. Le .env n est jamais commite.
#
# Un seul fichier d environnement pour tout le depot. Il est lu par :
#   - docker compose, pour les ${...} du docker-compose.yml
#   - le backend lance hors docker (services/backend/app/config.py)
#   - Vite, pour les variables prefixees VITE_ (services/web/vite.config.ts)

# Images. Laisser tel quel sur un poste : le compose construit et tague en
# local. Sur la VM, le deploiement renseigne ces trois valeurs pour repartir
# d une image publiee et precise, ce qui rend le retour arriere possible.
# IMAGE_REGISTRY se termine par une barre oblique, par exemple
# ghcr.io/alexisdraud/ . IMAGE_PULL_POLICY vide laisse a chaque service sa
# politique par defaut, la VM le passe a always.
IMAGE_REGISTRY=
IMAGE_TAG=local
IMAGE_PULL_POLICY=

# Base de donnees. Le nom d utilisateur et le nom de base ont une valeur par
# defaut dans le compose, ce sont des identifiants. Le mot de passe non : sans
# valeur ici, le compose refuse de demarrer.
POSTGRES_USER=seo
POSTGRES_PASSWORD=password
POSTGRES_DB=seo
DB_HOST_PORT=5433

# Utilise uniquement quand le backend tourne hors docker (alembic, pytest).
# Sous docker compose, DATABASE_URL est fabriquee par le compose et pointe
# vers l hote "db".
DATABASE_URL=postgresql+psycopg://seo:password@127.0.0.1:5433/seo

# Source de donnees (adresse donnee par le formateur, jamais en dur dans le code)
# L API tourne sur une autre machine du reseau de l ecole. La meme adresse
# marche depuis l hote et depuis un conteneur.
SOURCE_API_BASE_URL=http://127.0.0.1:8000

# Collecteur
# Cadence d interrogation de la source, en secondes.
COLLECTOR_INTERVAL_SECONDS=60
# Profondeur de la reprise d historique au premier demarrage, en jours.
# La source rend 1 mesure par minute : 7 jours = ~10 000 lignes par site,
# soit ~70 000 lignes pour les 7 sites.
BACKFILL_DAYS=7

# ETL
# Cadence de la boucle de transformation, en secondes.
ETL_INTERVAL_SECONDS=60
# Nombre de lignes brutes lues par requete a l interieur d une fenetre.
ETL_BATCH_SIZE=1000
# Recouvrement de la fenetre de lecture du brut, en minutes. Il doit couvrir la
# plus longue transaction d ecriture, qui dure des millisecondes. A ne pas
# confondre avec la fenetre de reparation ci-dessous.
ETL_WINDOW_OVERLAP_MINUTES=2

# Reparation des valeurs nulles (ADR du 04/09)
# Profondeur revisitee a chaque passage, en minutes.
IMPUTATION_WINDOW_MINUTES=30
# Age au dela duquel le profil d imputation d un site est recalcule, en heures.
IMPUTATION_PROFILE_REFRESH_HOURS=24

# API
API_PORT=8080

# Front
# WEB_BIND : interface d ecoute du dashboard. 127.0.0.1 le limite a cette
# machine, ce qui convient en local. Sur une VM partagee, mettre 0.0.0.0.
WEB_BIND=127.0.0.1
WEB_PORT=80
# Laisser vide tant que le front passe par le proxy nginx. Lue au build de
# l image web, pas au demarrage du conteneur.
VITE_BACK_API_URL=

# Authentification
JWT_SECRET_KEY=OK27XlD6fhby7oSftidIQfUpcVxASpEJ6GJdWNcKGDCAbNbi2OXhadJXnHn4IwZX
# Duree de l access token, en minutes. Le front le renouvelle tout seul.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Duree du cookie de session, en jours.
REFRESH_TOKEN_EXPIRE_DAYS=7
# A passer a true derriere HTTPS : le cookie de session n est alors plus
# envoye en clair.
COOKIE_SECURE=false
# Mot de passe des comptes de demonstration crees au premier demarrage.
SEED_USER_PASSWORD=tu24oZOOMAE9Kw1Vw9ZO
DATABASE_WAIT_SECONDS=30
PREDICTION_REFRESH_INTERVAL_SECONDS=60

# Superviseur ML (docs/ml-supervision.md). Valeurs de depart, a calibrer.
# Temps de sommeil entre deux tours, en secondes.
SUPERVISOR_INTERVAL_SECONDS=300
# Fenetre de decision : la MAE qui juge la derive, en heures (168 = 7 jours).
SUPERVISOR_DECISION_WINDOW_HOURS=168
# Fenetre d alerte : la MAE qui previent sans decider, en heures.
SUPERVISOR_ALERT_WINDOW_HOURS=24
# Delai de grace : donnees exigees depuis la premiere notation avant tout
# verdict, en heures.
SUPERVISOR_GRACE_HOURS=24
# Verrou : jamais deux lancements pour un site a moins de cet ecart, en heures.
SUPERVISOR_LOCK_HOURS=24
# Filet : age au-dela duquel un modele est reentraine meme sans derive, en jours.
SUPERVISOR_MAX_MODEL_AGE_DAYS=7
# Seuil de repli = MAE holdout x tolerance, quand le run MLflow n a pas de
# drift_threshold_mae.
SUPERVISOR_MAE_TOLERANCE=1.5


# MLflow + MinIO (ports exposes uniquement sur localhost)
# Utilise uniquement quand le backend tourne hors docker (alembic, pytest,
# python -m model.predict). Sous docker compose, MLFLOW_TRACKING_URI est fixe par
# le compose et pointe vers l hote "mlflow".
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_HOST_PORT=5000
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
# Identifiants du magasin d objets. Sans valeur ici, le compose refuse de
# demarrer : un magasin d artefacts ouvert sur ses identifiants d usine est la
# premiere porte qu on essaie.
MINIO_ROOT_USER=enervision_wnfaaley
MINIO_ROOT_PASSWORD=EOIGn65ScRxgRRoRqHBv4ogPqpMe1jrK2lyRlWlR
ML_TRAIN_ON_START=1
MLFLOW_START_TIMEOUT_SECONDS=120
# Holdout court pour les 24h de demonstration, pas une evaluation de production.
TRAIN_ARGS=--holdout-minutes 120
