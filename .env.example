# Copier en .env et remplir. Le .env n'est jamais commite.
# Chaque nom present ici doit exister dans le .env de chacun, sinon
# "docker compose up" s'arrete au demarrage.

# Base de donnees
POSTGRES_USER=seo
POSTGRES_PASSWORD=change_moi
POSTGRES_DB=seo
DB_HOST_PORT=5432

# Source de donnees (adresse donnee par le formateur, jamais en dur dans le code)
SOURCE_API_BASE_URL=http://127.0.0.1:8000
SOURCE_API_TOKEN=

COLLECTOR_INTERVAL_SECONDS=60
ETL_INTERVAL_SECONDS=60
ETL_WINDOW_MINUTES=30
ETL_MAX_GAP_MINUTES=3

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# API
API_PORT=8080
JWT_SECRET_KEY=replace-with-a-random-32-character-minimum-secret
SEED_USER_PASSWORD=EnerVisionDemo2026!
DATABASE_WAIT_SECONDS=30

# Canal d'alerte sortant

# Donnees de demonstration
# ./scripts/seed-mock-data.sh insere le jeu mock apres docker compose up -d db.
