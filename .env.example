# Copier en .env et remplir. Le .env n'est jamais commite.
# Chaque nom present ici doit exister dans le .env de chacun, sinon
# "docker compose up" s'arrete au demarrage.

# Base de donnees
POSTGRES_USER=seo
POSTGRES_PASSWORD=change_moi
POSTGRES_DB=seo
# Adresse vue depuis les conteneurs. "db" est le nom du service dans le compose,
# ce n'est pas localhost. seo_common.db.dsn() assemble l'adresse a partir de ces cinq
# variables : ne pas en ajouter une sixieme qui dirait la meme chose autrement.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Source de donnees (adresse donnee par le formateur, jamais en dur dans le code)
SOURCE_API_BASE_URL=http://127.0.0.1:8000
SOURCE_API_TOKEN=

# Collecte et transformation, en secondes
COLLECTOR_INTERVAL_SECONDS=60
ETL_INTERVAL_SECONDS=900

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# API
API_PORT=8080
# Cle de signature des jetons. En generer une par environnement :
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_moi
JWT_EXPIRE_MINUTES=30

# Front. Adresse de l'API telle que le NAVIGATEUR la voit, pas les conteneurs.
# En local : http://localhost:8080/api/v1
# Sur la VM : http://<adresse-de-la-vm>:8080/api/v1
WEB_API_BASE_URL=http://localhost:8080/api/v1
# Origine autorisee a appeler l'API depuis un navigateur (CORS).
WEB_ORIGIN=http://localhost:5173

# Canal d'alerte sortant (repousse, voir decision 15)
ALERT_WEBHOOK_URL=
