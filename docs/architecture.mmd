    subgraph DB["PostgreSQL"]
        RAW[("Couche brute<br/>JSONB, append only")]
        CLEAN[("Couche transformee<br/>tables typees + index")]
    end

    TR["Job ETL Python<br/>toutes les 15 minutes"]

    subgraph ML["Machine learning"]
        FEAT["Paquet commun<br/>calcul des variables"]
        TRAIN["Entrainement<br/>gradient boosting"]
        MLF["MLflow<br/>suivi + registre"]
    end

    BACK["Backend FastAPI<br/>REST + JWT"]
    FRONT["Front React"]
    NOTIF["Canal sortant<br/>hors perimetre pour l'instant<br/>voir decision 15"]
    CI["CI/CD GitHub Actions<br/>lint, tests, scan, deploiement"]

    CSV --> BOOT
    SRC --> BOOT
    SRC --> POLL
    BOOT --> RAW
    POLL --> RAW
    RAW --> TR
    TR --> CLEAN
    CLEAN -.-> TRAIN
    FEAT -.-> TRAIN
    FEAT --> BACK
    TRAIN -.-> MLF
    MLF -.-> BACK
    CLEAN --> BACK
    BACK --> FRONT
    BACK -.-> NOTIF
    CI -.-> TR
    CI -.-> BACK
    CI -.-> FRONT

    classDef store fill:#eef4ff,stroke:#4a6fa5,color:#12203a
    classDef later fill:#f4f4f6,stroke:#a8adb7,color:#5a6472,stroke-dasharray:4 3
