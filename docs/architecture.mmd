%% EnerVision - architecture de realisation - mis a jour le 10/09/2026
%% Tout ce qui figure ici tourne. Les manques sont listes dans docs/architecture.md.
%% A coller sur https://mermaid.live
flowchart LR
    SRC["API source (reseau ecole)<br/>/sites, /sites/{id}/current<br/>/sensors/status, /alerts<br/>/readings (reprise d historique)"]

    subgraph INGEST["Ingestion"]
        BOOT["Reprise d historique<br/>au premier demarrage<br/>fenetres de 1000 min<br/>garde de couverture"]
        POLL["Collecteur<br/>toutes les 60 s"]
    end

    subgraph BRONZE["Bronze - brut, insertion seule"]
        RAW[("raw_readings<br/>JSONB + colonnes generees")]
        SNAP[("raw_snapshots<br/>sites, capteurs, alertes")]
    end

    ETL["ETL<br/>toutes les 60 s<br/>fenetre de reception + 2 min<br/>lots de 1000 lignes"]

    subgraph SILVER["Silver - valide"]
        SITES[("sites")]
        READ[("readings<br/>+ imputation")]
        SENS[("sensor_status")]
    end

    subgraph GOLD["Gold - exploitable"]
        QUAL[("data_quality_daily")]
        PRED[("predictions<br/>erreur absolue generee")]
        ALERT[("alerts")]
    end

    RUNS[("etl_runs<br/>tracabilite des passages")]

    subgraph MLBLOC["Apprentissage"]
        FEAT["packages/features<br/>variables partagees"]
        TRAIN["Entrainement<br/>1 modele par site<br/>RandomForest / ExtraTrees"]
        MLF["Serveur MLflow<br/>suivi SQLite<br/>registre + alias production"]
        MINIO[("MinIO<br/>artefacts S3")]
    end

    WORKER["Worker de prevision<br/>toutes les 60 s<br/>H+2, notation a echeance"]
    SUP["Superviseur<br/>toutes les 300 s<br/>decide et journalise"]

    API["API FastAPI<br/>JWT + roles<br/>agregats calcules a la volee"]
    WEB["Front React<br/>servi par nginx<br/>proxy /api"]
    USER["Navigateur<br/>port 80 de la VM"]

    subgraph CICD["Chaine de livraison"]
        GHA["GitHub Actions<br/>lint, tests, Trivy"]
        GHCR[("GHCR<br/>tag SHA + tag branche")]
        RUNNER["Runner auto-heberge<br/>sur la VM"]
        ANS["Playbook Ansible<br/>configuration + deploiement"]
    end

    SRC --> BOOT
    SRC --> POLL
    BOOT --> RAW
    POLL --> RAW
    POLL --> SNAP

    RAW --> ETL
    SNAP --> ETL
    ETL --> SITES
    ETL --> READ
    ETL --> SENS
    ETL --> QUAL
    ETL --> ALERT
    ETL --> RUNS

    READ --> FEAT
    FEAT --> TRAIN
    TRAIN --> MLF
    MLF --> MINIO

    MLF --> WORKER
    FEAT --> WORKER
    READ --> WORKER
    WORKER --> PRED
    WORKER --> ALERT
    PRED --> SUP
    MLF --> SUP

    SITES --> API
    READ --> API
    QUAL --> API
    PRED --> API
    ALERT --> API
    SENS --> API
    RUNS --> API

    API --> WEB
    WEB --> USER

    GHA --> GHCR
    GHCR --> ANS
    GHA --> RUNNER
    RUNNER --> ANS
    ANS --> API
    ANS --> WEB
